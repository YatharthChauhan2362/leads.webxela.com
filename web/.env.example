# Supabase (server only). The secret key bypasses row level security, never send it to the browser.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Only for the Supabase CLI (supabase db push, gen types).
SUPABASE_ACCESS_TOKEN=

# AI scoring and reply drafts (OpenAI compatible). Leave AI_API_KEY empty to use keyword scoring.
AI_BASE_URL=https://ai.yatricloud.com/v1
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Zoho SMTP for hot lead emails. EMAIL_TO defaults to EMAIL_USER.
EMAIL_HOST=smtp.zoho.in
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME="Yatri Cloud"
EMAIL_TO=
# Backup Zoho account, used if the main one fails to send.
EMAIL_USER_2=
EMAIL_PASS_2=
# Link used in alert emails.
APP_URL=http://localhost:3000

# Turns on the sign in prompt for every page (any user name, this password). Set it on Vercel.
APP_PASSWORD=
# If set, the extension and outside cron must send this as x-api-key.
INGEST_KEY=

# How often the server checks Reddit and Hacker News, in minutes.
POLL_MINUTES=30

# Reddit official API. Create a "script" app at https://www.reddit.com/prefs/apps and paste its id and secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=


# Sign in with Google or Zoho. Sign in turns on once either client id and secret are set.
# Redirect URIs: <APP_URL>/auth/google/callback and <APP_URL>/auth/zoho/callback
SESSION_SECRET=
OWNER_EMAILS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
